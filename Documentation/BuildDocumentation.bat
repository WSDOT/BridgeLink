REM - The documentation version (x.y) comes from WBFL_VERSION_STRING in WBFL\Include\WBFLVersion.h
call %ARPDIR%\BridgeLink\GetVersion.bat
if errorlevel 1 exit /B 1

cd %ARPDIR%\BridgeLink\Documentation

rmdir /S /Q doc
doxygen Doxygen.dox

rem ** The code below replaces Doxygen's search.js file with version from https://github.com/divideconcept/DoxygenDeepSearch
rem    into our html help system to enable plain text search on both browser and server.
copy /Y %ARPDIR%\WBFL\DoxygenDeepSearch\search.js doc\html\search\search.js

rem ** Use of the deep search search.js requires modification of the search.html generated by Doxygen
rem    search xml data is appended as a script to the end of the file
set SEARCH_HTML=doc\html\search.html  
echo ^<script id="searchdata" type="text/xmldata"^> >> %SEARCH_HTML%
type doc\searchdata.xml >> %SEARCH_HTML%
echo ^</script^> >> %SEARCH_HTML%


%ARPDIR%\BridgeLink\RegFreeCOM\x64\Release\MakeDocMap BridgeLink
rem ** Make the BridgeLink copy the same as the build, copying only changed files so unchanged files keep
rem    their timestamps (PublishDocumentation.bat then sends only what changed to the server)
powershell -NoProfile -ExecutionPolicy Bypass -File %ARPDIR%\BridgeLink\SyncFolder.ps1 -Source %ARPDIR%\BridgeLink\Documentation\doc\html -Target %ARPDIR%\BridgeLink\Docs\BridgeLink\%ARP_DOCUMENTATION_VERSION% -Keep *.dm
if errorlevel 1 exit /B 1
powershell -NoProfile -ExecutionPolicy Bypass -File %ARPDIR%\BridgeLink\SyncFolder.ps1 -Source %ARPDIR%\BridgeLink\Documentation\BridgeLink.dm -Target %ARPDIR%\BridgeLink\Docs\BridgeLink\%ARP_DOCUMENTATION_VERSION%\BridgeLink.dm
if errorlevel 1 exit /B 1
