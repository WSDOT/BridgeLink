<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
   <!-- Visual C++ runtime merge modules. They must match the platform toolset the binaries are built
        with (v145, Visual Studio 2026). Change the folder for another edition (Community, Enterprise). -->
   <?define VCMergeModules=C:\Program Files\Microsoft Visual Studio\18\Professional\VC\Redist\MSVC\v145\MergeModules?>

   <Fragment Id="MergeModules">
   <!-- Merge Modules -->
   <DirectoryRef Id="TARGETDIR">
      <Merge Id="VCRedist"
             SourceFile="$(var.VCMergeModules)\Microsoft_VC145_CRT_x64.msm"
             DiskId="1"
             Language="0"/>
     <Merge Id="MFCRedist"
             SourceFile="$(var.VCMergeModules)\Microsoft_VC145_MFC_x64.msm"
             DiskId="1"
             Language="0"/>
     <Merge Id="MFCLocRedist"
            SourceFile="$(var.VCMergeModules)\Microsoft_VC145_MFCLOC_x64.msm"
            DiskId="1"
            Language="0"/>
   </DirectoryRef>

   <Feature Id="Redistributables"
            Title="CTR, MFC, ATL, etc"
            AllowAdvertise="no"
            Display="hidden"
            Absent="disallow"
            Level="1">
      <MergeRef Id="VCRedist"/>
     <MergeRef Id="MFCRedist"/>
     <MergeRef Id="MFCLocRedist"/>
   </Feature>
   </Fragment>
</Wix>
